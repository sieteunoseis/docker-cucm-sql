{
  "name": "docker-cucm-sql",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Web-based SQL editor for Cisco CUCM (AXL executeSQLQuery) with multi-cluster support",
  "scripts": {
    "build": "tsc -p . && npm --prefix web run build",
    "build:server": "tsc -p .",
    "test": "vitest run && npm --prefix web test",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist/server/index.js",
    "test:server": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "archiver": "^8.0.0",
    "cisco-axl": "^2.1.3",
    "fastify": "^5.12.8",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.5",
    "adm-zip": "^0.6.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
