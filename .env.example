NODE_ENV=production

# Default cluster (same variables as 0.x — existing .env files keep working)
CUCM_HOSTNAME=cucm-pub.example.com
CUCM_USERNAME=axluser
CUCM_PASSWORD=changeme
CUCM_VERSION=14.0
# Optional display name (defaults to CUCM_HOSTNAME)
#CUCM_NAME=Production

# Additional clusters: CUCM_2_*, CUCM_3_*, ... (read until the first missing CUCM_<N>_HOSTNAME)
#CUCM_2_NAME=Lab
#CUCM_2_HOSTNAME=cucm-lab.example.com
#CUCM_2_USERNAME=axluser
#CUCM_2_PASSWORD=changeme
#CUCM_2_VERSION=15.0

# Optional
#QUERY_TIMEOUT=60            # seconds per cluster request
#MAX_BATCHES=200             # cap on SKIP/FIRST batches for one "fetch all"
#LOG_RETENTION_MONTHS=12     # activity log months kept in data/.logs
#API_KEY=                    # required by /api/run when no Remote-User header is present
